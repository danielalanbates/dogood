# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Scopes needed: repo, read:user, public_repo
GITHUB_TOKEN=ghp_your_token_here

# GitHub username
GITHUB_USERNAME=danielalanbates

# Path where repos are cloned for solving
WORK_DIR=/tmp/dogood-workdir

# Optional extra folder of issue spreadsheets (*.csv), e.g. a synced Google
# Drive copy. The repo's spreadsheets/ folder is always used as well.
# DOGOOD_SPREADSHEETS_DIR=~/path/to/dogood/spreadsheets
